---
const today = new Date();
const base = '/my-blog';
---

<footer>
	<div class="footer-inner">
		<div class="footer-top">
			<div class="footer-brand">
				<p class="footer-logo">🪄 K잇핏</p>
				<p class="footer-desc">똑똑한 소비를 위한 모든 것</p>
			</div>
			<div class="footer-links">
				<a href={`${base}/`}>홈</a>
				<a href={`${base}/blog`}>전체 글</a>
				<a href={`${base}/about`}>소개</a>
			</div>
		</div>
		<div class="footer-bottom">
			<p>&copy; {today.getFullYear()} K잇핏. All rights reserved.</p>
		</div>
	</div>
</footer>
<style>
	footer {
		background: var(--primary-dark);
		color: rgba(255,255,255,0.7);
		padding: 3em 1.5em 2em;
	}
	.footer-inner {
		max-width: 960px;
		margin: 0 auto;
	}
	.footer-top {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		padding-bottom: 2em;
		border-bottom: 1px solid rgba(255,255,255,0.1);
	}
	.footer-logo {
		font-weight: 800;
		font-size: 1.1em;
		color: white;
		margin: 0 0 0.3em;
	}
	.footer-desc {
		font-size: 0.85em;
		margin: 0;
		color: rgba(255,255,255,0.5);
	}
	.footer-links {
		display: flex;
		gap: 1.5em;
	}
	.footer-links a {
		color: rgba(255,255,255,0.6);
		font-size: 0.9em;
		text-decoration: none;
	}
	.footer-links a:hover {
		color: white;
		opacity: 1;
	}
	.footer-bottom {
		padding-top: 1.5em;
		text-align: center;
	}
	.footer-bottom p {
		font-size: 0.8em;
		margin: 0;
		color: rgba(255,255,255,0.35);
	}
	@media (max-width: 720px) {
		.footer-top { flex-direction: column; gap: 1em; }
	}
</style>
