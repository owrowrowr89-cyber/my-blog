---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import mascotImg from '../assets/mascot.png';

const base = '/my-blog';
const allPosts = await getCollection('blog');
const recentPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 5);
const postCount = allPosts.length;
---

<aside class="sidebar">
	<div class="sidebar-card profile-card">
		<Image src={mascotImg} alt="K잇핏" class="profile-img" />
		<p class="profile-name">K잇핏</p>
		<p class="profile-desc">똑똑한 소비를 위한 모든 것</p>
		<a href={`${base}/about`} class="profile-link">소개 →</a>
	</div>

	<div class="sidebar-card">
		<h3 class="sidebar-title">📂 카테고리</h3>
		<ul class="category-list">
			<li><a href={`${base}/category/it/`}>💻 IT기기</a> <span class="cat-count">8</span></li>
			<li><a href={`${base}/category/food/`}>🍽️ K로컬잇슐랭</a> <span class="cat-count">3</span></li>
			<li><a href={`${base}/category/health/`}>💊 건강/의학</a> <span class="cat-count">1</span></li>
			<li><a href={`${base}/category/edu/`}>📚 교육</a> <span class="cat-count">2</span></li>
		</ul>
	</div>

	<div class="sidebar-card">
		<h3 class="sidebar-title">📋 최신 글</h3>
		<ul class="recent-list">
			{recentPosts.map((post) => (
				<li>
					<a href={`${base}/blog/${post.id}/`}>
						<span class="recent-title">{post.data.title}</span>
						<span class="recent-date">{post.data.pubDate.toLocaleDateString('ko-KR', { month: 'short', day: 'numeric' })}</span>
					</a>
				</li>
			))}
		</ul>
	</div>

	<div class="sidebar-card stats-card">
		<h3 class="sidebar-title">📊 블로그 정보</h3>
		<div class="stat-row"><span>전체 글</span><span>{postCount}개</span></div>
		<div class="stat-row"><span>카테고리</span><span>4개</span></div>
		<div class="stat-row"><span>운영</span><span>K잇핏</span></div>
	</div>
</aside>
<style>
	.sidebar { width: 260px; flex-shrink: 0; }
	.sidebar-card {
		background: white; border-radius: 12px; padding: 1.2em;
		margin-bottom: 1em; box-shadow: var(--card-shadow);
		border: 1px solid var(--accent-light);
	}
	.profile-card { text-align: center; }
	.profile-img { width: 80px; height: 80px; object-fit: contain; margin: 0 auto 0.5em; border-radius: 50%; border: 2px solid var(--primary); padding: 2px; }
	.profile-name { font-weight: 700; font-size: 1em; color: rgb(var(--black)); margin: 0 0 0.2em; }
	.profile-desc { font-size: 0.78em; color: rgb(var(--gray)); margin: 0 0 0.5em; line-height: 1.4; }
	.profile-link { font-size: 0.78em; color: var(--primary); font-weight: 600; }
	.sidebar-title { font-size: 0.85em; color: var(--primary-dark); margin: 0 0 0.7em; padding-bottom: 0.4em; border-bottom: 2px solid var(--primary-light); }
	.category-list { list-style: none; padding: 0; margin: 0; }
	.category-list li { display: flex; justify-content: space-between; align-items: center; padding: 0.4em 0; font-size: 0.82em; border-bottom: 1px solid var(--accent-light); }
	.category-list li:last-child { border-bottom: none; }
	.category-list a { color: rgb(var(--gray-dark)); text-decoration: none; }
	.category-list a:hover { color: var(--primary); }
	.cat-count { background: var(--primary-light); color: var(--primary-dark); padding: 0.1em 0.5em; border-radius: 10px; font-size: 0.78em; font-weight: 600; }
	.recent-list { list-style: none; padding: 0; margin: 0; }
	.recent-list li { padding: 0.4em 0; border-bottom: 1px solid var(--accent-light); }
	.recent-list li:last-child { border-bottom: none; }
	.recent-list a { text-decoration: none; display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5em; }
	.recent-title { font-size: 0.78em; color: rgb(var(--gray-dark)); line-height: 1.4; flex: 1; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
	.recent-list a:hover .recent-title { color: var(--primary); }
	.recent-date { font-size: 0.7em; color: rgb(var(--gray)); white-space: nowrap; }
	.stats-card {}
	.stat-row { display: flex; justify-content: space-between; padding: 0.3em 0; font-size: 0.8em; color: rgb(var(--gray-dark)); border-bottom: 1px solid var(--accent-light); }
	.stat-row:last-child { border-bottom: none; }
	@media (max-width: 800px) { .sidebar { width: 100%; } }
</style>
