---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BaseHead from '../components/BaseHead.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_SUBTITLE } from '../consts';
import mascotImg from '../assets/mascot.png';

const base = '/my-blog';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentPosts = posts.slice(0, 6);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- 히어로 - K잇핏 캐릭터 + 소개 -->
			<section class="hero">
				<div class="hero-content">
					<div class="hero-text">
						<h1>{SITE_SUBTITLE}</h1>
						<p>IT 기기부터 맛집, 자동차, 뷰티까지<br/>K잇핏이 솔직하게 알려드려요 🪄</p>
						<a href={`${base}/blog`} class="btn">전체 글 보러가기 →</a>
					</div>
					<div class="hero-mascot">
						<Image src={mascotImg} alt="K잇핏 캐릭터" class="mascot-img" />
					</div>
				</div>
			</section>

			<!-- 최신 포스트 -->
			<section class="featured">
				<div class="section-header">
					<h2>📋 최신 글</h2>
					<a href={`${base}/blog`} class="btn btn-outline">모두 보기 →</a>
				</div>
				<div class="post-grid">
					{
						recentPosts.map((post) => (
							<article class="post-card">
								<a href={`${base}/blog/${post.id}/`}>
									<div class="post-img-wrap">
										{post.data.heroImage ? (
											<Image width={600} height={340} src={post.data.heroImage} alt="" class="post-img" />
										) : (
											<div class="post-img-placeholder">📝</div>
										)}
									</div>
									<div class="post-body">
										<span class="tag">
											{post.data.tags?.[0] || '리뷰'}
										</span>
										<h3>{post.data.title}</h3>
										<p class="post-desc">{post.data.description}</p>
										<span class="post-date">
											{post.data.pubDate.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}
										</span>
									</div>
								</a>
							</article>
						))
					}
				</div>
			</section>

			<!-- 캐릭터 소개 -->
			<section class="about-card">
				<div class="about-inner">
					<Image src={mascotImg} alt="K잇핏" class="about-mascot" />
					<div class="about-text">
						<h2>🪄 안녕하세요, K잇핏입니다</h2>
						<p>똑똑한 소비를 위해 IT부터 맛집, 자동차, 뷰티까지 가리지 않고 솔직하게 리뷰해요. 광고성 정보는 No, 실제 경험담은 Yes!</p>
						<a href={`${base}/about`} class="btn btn-outline">더 알아보기 →</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* Hero */
	.hero {
		padding: 3em 0 2em;
	}
	.hero-content {
		display: flex;
		align-items: center;
		gap: 3em;
	}
	.hero-text {
		flex: 1;
	}
	.hero-text h1 {
		font-size: 2.4em;
		margin-bottom: 0.4em;
		color: var(--primary-dark);
		line-height: 1.2;
	}
	.hero-text p {
		font-size: 1.1em;
		color: rgb(var(--gray));
		margin-bottom: 1.5em;
		line-height: 1.6;
	}
	.hero-mascot {
		flex-shrink: 0;
		width: 200px;
		height: 200px;
	}
	.mascot-img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		border-radius: 50%;
		border: 3px solid var(--primary);
		background: white;
		padding: 4px;
	}

	/* Featured Section */
	.featured {
		margin: 1em 0 3em;
	}
	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1.5em;
	}
	.section-header h2 {
		margin: 0;
		color: var(--primary-dark);
	}
	.post-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.2em;
	}
	.post-card {
		background: white;
		border-radius: 16px;
		overflow: hidden;
		box-shadow: var(--card-shadow);
		border: 1px solid var(--accent-light);
		transition: transform 0.2s, box-shadow 0.2s;
	}
	.post-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 8px 30px rgba(0, 0, 0, 8%);
	}
	.post-card a {
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		height: 100%;
	}
	.post-card a:hover { opacity: 1; }
	.post-img-wrap {
		width: 100%;
		height: 170px;
		overflow: hidden;
	}
	.post-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		transition: transform 0.3s;
	}
	.post-card:hover .post-img {
		transform: scale(1.05);
	}
	.post-img-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 3em;
		background: var(--accent-light);
	}
	.post-body {
		padding: 1em 1.2em 1.2em;
		display: flex;
		flex-direction: column;
		gap: 0.4em;
		flex: 1;
	}
	.post-body h3 {
		font-size: 0.95em;
		margin: 0;
		color: rgb(var(--black));
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.post-desc {
		font-size: 0.8em;
		color: rgb(var(--gray));
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		flex: 1;
	}
	.post-date {
		font-size: 0.75em;
		color: rgb(var(--gray));
	}

	/* About Card */
	.about-card {
		background: var(--primary);
		border-radius: 20px;
		padding: 2em;
		margin: 2em 0;
	}
	.about-inner {
		display: flex;
		align-items: center;
		gap: 2em;
	}
	.about-mascot {
		width: 120px;
		height: 120px;
		object-fit: contain;
		flex-shrink: 0;
	}
	.about-text h2 {
		color: white;
		margin: 0 0 0.5em;
	}
	.about-text p {
		color: rgba(255,255,255,0.85);
		font-size: 0.9em;
		margin: 0 0 1em;
		line-height: 1.6;
	}
	.about-text .btn-outline {
		color: white;
		border-color: rgba(255,255,255,0.5);
	}
	.about-text .btn-outline:hover {
		background: white;
		color: var(--primary);
		border-color: white;
	}

	@media (max-width: 720px) {
		.hero-content { flex-direction: column; text-align: center; gap: 1.5em; }
		.hero-text h1 { font-size: 1.6em; }
		.hero-mascot { width: 140px; height: 140px; }
		.post-grid { grid-template-columns: 1fr; }
		.about-inner { flex-direction: column; text-align: center; }
	}
</style>
