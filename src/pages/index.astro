---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import BaseHead from '../components/BaseHead.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_SUBTITLE } from '../consts';
import mascotImg from '../assets/mascot.png';

const base = '/my-blog';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="layout-with-sidebar">
				<div class="content-area">
					<div class="hero-mini">
						<Image src={mascotImg} alt="K잇핏" class="hero-mini-img" />
						<div>
							<h1>{SITE_SUBTITLE}</h1>
							<p>IT 기기부터 맛집, 건강, 교육까지 K잇핏이 솔직하게 알려드려요 🪄</p>
						</div>
					</div>

					<div class="section-header">
						<h2>📋 최신 글</h2>
						<span class="post-count">총 {posts.length}개</span>
					</div>

					<div class="post-list">
						{posts.map((post) => (
							<article class="post-row">
								<a href={`${base}/blog/${post.id}/`} class="post-row-link">
									<div class="post-row-img-wrap">
										{post.data.heroImage ? (
											<Image width={200} height={140} src={post.data.heroImage} alt="" class="post-row-img" />
										) : (
											<div class="post-row-img-placeholder">📝</div>
										)}
									</div>
									<div class="post-row-body">
										<span class="tag">{post.data.tags?.[0] || '리뷰'}</span>
										<h2>{post.data.title}</h2>
										<p class="post-row-desc">{post.data.description}</p>
										<span class="post-row-date">
											{post.data.pubDate.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}
										</span>
									</div>
								</a>
							</article>
						))}
					</div>
				</div>
				<Sidebar />
			</div>
		</main>
		<Footer />
	</body>
</html>
<style>
	.layout-with-sidebar { display: flex; gap: 2em; align-items: flex-start; padding: 1.5em 0; }
	.content-area { flex: 1; min-width: 0; }
	.hero-mini {
		display: flex; align-items: center; gap: 1em;
		background: var(--primary); border-radius: 14px; padding: 1.2em 1.5em; margin-bottom: 1.2em;
	}
	.hero-mini-img { width: 60px; height: 60px; object-fit: contain; border-radius: 50%; border: 2px solid rgba(255,255,255,0.3); padding: 2px; flex-shrink: 0; }
	.hero-mini h1 { color: white; font-size: 1.1em; margin: 0 0 0.1em; }
	.hero-mini p { color: rgba(255,255,255,0.75); font-size: 0.78em; margin: 0; line-height: 1.4; }
	.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.8em; }
	.section-header h2 { margin: 0; color: var(--primary-dark); font-size: 1.1em; }
	.post-count { font-size: 0.78em; color: rgb(var(--gray)); }
	.post-list { display: flex; flex-direction: column; gap: 0.8em; }
	.post-row {
		background: white; border-radius: 12px; overflow: hidden;
		box-shadow: 0 1px 3px rgba(0,0,0,4%); border: 1px solid var(--accent-light);
		transition: box-shadow 0.2s;
	}
	.post-row:hover { box-shadow: 0 2px 8px rgba(0,0,0,6%); }
	.post-row-link { display: flex; text-decoration: none; color: inherit; }
	.post-row-link:hover { opacity: 1; }
	.post-row-img-wrap { width: 200px; min-height: 140px; flex-shrink: 0; overflow: hidden; }
	.post-row-img { width: 100%; height: 100%; object-fit: cover; border-radius: 0; }
	.post-row-img-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 2em; background: var(--accent-light); }
	.post-row-body { padding: 0.8em 1em; display: flex; flex-direction: column; gap: 0.3em; flex: 1; }
	.post-row-body h2 { font-size: 0.92em; margin: 0; color: rgb(var(--black)); line-height: 1.4; }
	.post-row-desc { font-size: 0.78em; color: rgb(var(--gray)); margin: 0; flex: 1; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
	.post-row-date { font-size: 0.73em; color: rgb(var(--gray)); }
	@media (max-width: 800px) {
		.layout-with-sidebar { flex-direction: column; }
		.hero-mini { flex-direction: column; text-align: center; }
		.post-row-link { flex-direction: column; }
		.post-row-img-wrap { width: 100%; height: 160px; }
	}
</style>
